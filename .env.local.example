# Copiază acest fișier în .env.local și completează valorile din
# Supabase → Project Settings → Data API / API Keys.
# .env.local nu se urcă niciodată pe GitHub (e în .gitignore).

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API Keys → service_role (SECRET — doar server, doar
# pentru scripturi de administrare/seed; niciodată în cod client)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string → URI (folosit de Drizzle
# pentru migrări: npm run db:generate / db:migrate)
DATABASE_URL=
